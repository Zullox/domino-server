# ============================================================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================================================
# Copiar este archivo y completar los valores en tu plataforma de hosting

# ══════════════════════════════════════════════════════════════════════════════
# SERVIDOR
# ══════════════════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3001

# ══════════════════════════════════════════════════════════════════════════════
# CORS - URLs del cliente permitidas (separadas por coma, sin espacios)
# ══════════════════════════════════════════════════════════════════════════════
# Ejemplo: https://tu-app.vercel.app,https://tu-dominio.com
CORS_ORIGINS=https://tu-app.vercel.app

# ══════════════════════════════════════════════════════════════════════════════
# FIREBASE ADMIN SDK
# ══════════════════════════════════════════════════════════════════════════════
# Obtener de: Firebase Console > Project Settings > Service Accounts > Generate New Private Key

FIREBASE_PROJECT_ID=domino-online-4cc5f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@domino-online-4cc5f.iam.gserviceaccount.com

# IMPORTANTE: La private key debe estar en una sola línea con \n para los saltos
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_COMPLETA_AQUI\n-----END PRIVATE KEY-----\n"

# ══════════════════════════════════════════════════════════════════════════════
# MATCHMAKING
# ══════════════════════════════════════════════════════════════════════════════
MATCHMAKING_TIMEOUT_MS=60000
RATING_RANGE_INITIAL=100
RATING_RANGE_INCREMENT=50
RATING_RANGE_MAX=500

# ══════════════════════════════════════════════════════════════════════════════
# JUEGO
# ══════════════════════════════════════════════════════════════════════════════
TURN_TIMEOUT_SECONDS=30
DEFAULT_TARGET_SCORE=100
