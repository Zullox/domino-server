# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR - DOMINÓ CUBANO
# ============================================================================

# Servidor
PORT=3001
NODE_ENV=development

# Firebase Admin SDK
# Descargar desde: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=domino-online-4cc5f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@domino-online-4cc5f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"

# O usar archivo de credenciales
# GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json

# CORS
CORS_ORIGIN=http://localhost:5173,https://tu-dominio.com

# Matchmaking
MATCHMAKING_TIMEOUT=60000
RATING_RANGE_INITIAL=100
RATING_RANGE_INCREMENT=50
RATING_RANGE_MAX=500

# Juego
TURN_TIME=30
TARGET_SCORE=100
